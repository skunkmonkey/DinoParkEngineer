{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "app/page.tsx",
    "app/layout.tsx",
    "app/[...path]/page.tsx",
    "src/shell/**/*.ts",
    "src/shell/**/*.tsx",
    "src/features/**/*.ts",
    "src/shell-diagnostics/**/*.ts",
    "src/shell-diagnostics/**/*.tsx",
    "tests/shell-contracts.test.ts",
    "tests/fixtures/**/*.ts"
  ],
  "exclude": ["node_modules", "src/platform", "src/ui", "src/shared", "simulation"]
}
